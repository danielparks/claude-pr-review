#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  echo "Usage: ${0##*/} X.Y.Z [message]" >&2
}

if [[ $# -lt 1 ]]; then
  usage
  exit 1
fi

if [[ "$1" == --help ]]; then
  usage
  exit 0
fi

version=$1
message=${2:-}

if ! [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "Error: version must be X.Y.Z where X, Y, Z are digits" >&2
  exit 1
fi

if [[ -n "$(git status --porcelain)" ]]; then
  echo "Error: working tree is dirty" >&2
  exit 1
fi

major="${BASH_REMATCH[1]}"
minor="${BASH_REMATCH[2]}"

tag_full="v${version}"
tag_major="v${major}"
tag_minor="v${major}.${minor}"

if git rev-parse "$tag_full" &>/dev/null; then
  echo "Error: tag $tag_full already exists" >&2
  exit 1
fi

if [[ -n "$message" ]]; then
  full_message="${tag_full}: ${message}"
else
  full_message="${tag_full}"
fi

git tag -s "$tag_full" -m "$full_message"
git tag -s -f "$tag_major" -m "Release ${tag_major}"
git tag -s -f "$tag_minor" -m "Release ${tag_minor}"

git push origin "$tag_full"
git push --force origin "$tag_major" "$tag_minor"

if [[ -n "$message" ]]; then
  gh release create "$tag_full" --title "$tag_full" --notes "$message"
else
  gh release create "$tag_full" --title "$tag_full" --generate-notes
fi
