#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat >&2 <<EOF
Usage: ${0##*/}

Bump the pinned actionlint/ghalint versions in
.github/workflows/pr-checks.yaml to their latest GitHub releases, and the
pinned oxfmt version in scripts/format and cli/package.json (plus its lock
file) to the latest npm release.

This does not verify the new release's attestation itself. Bumping the
version busts the actions/cache key in that workflow, so the next time
pr-checks.yaml runs it will download the new release fresh and run
\`gh attestation verify\` on it as usual.
EOF
}

if [[ ${1:-} == --help ]]; then
  usage; exit 0
fi

if ! command -v gh &>/dev/null; then
  echo "Error: this script requires the gh CLI" >&2
  exit 1
fi

FILE=.github/workflows/pr-checks.yaml

update_version() {
  local var="$1" repo="$2" current latest tmp

  current=$(awk '/^ +'"${var}"': / { print $2 }' "$FILE")
  if [[ -z "$current" ]] ; then
    echo "Variable ${var} not found in ${FILE}" >&2
    exit 1
  fi

  if [[ "$current" =~ [[:space:]] ]] ; then
    echo "Found multiple copies of ${var} in ${FILE}" >&2
    exit 1
  fi

  latest=$(gh api "repos/${repo}/releases/latest" --jq .tag_name)

  if [[ "$current" == "$latest" ]]; then
    return
  fi

  tmp=$(mktemp)
  # $current contains . but it will likely match correctly because of $var
  sed "s/${var}: ${current}/${var}: ${latest}/" "$FILE" > "$tmp"
  mv "$tmp" "$FILE"
  echo "Updated ${var}: ${current} -> ${latest}"
}

update_version ACTIONLINT_VERSION kjanat/actionlint
update_version GHALINT_VERSION suzuki-shunsuke/ghalint

update_oxfmt() {
  local current latest tmp

  current=$(sed -n 's/.*--package=oxfmt@\([0-9][^ ]*\) .*/\1/p' scripts/format)
  if [[ -z "$current" ]] ; then
    echo "Pinned oxfmt version not found in scripts/format" >&2
    exit 1
  fi

  latest=$(npm view oxfmt version)
  if [[ "$current" == "$latest" ]]; then
    return
  fi

  sed -i.bak "s/--package=oxfmt@${current} /--package=oxfmt@${latest} /" \
    scripts/format
  rm scripts/format.bak
  # Updates cli/package.json and cli/package-lock.json without touching
  # node_modules.
  (cd cli && npm install --package-lock-only --save-dev --save-exact \
    "oxfmt@${latest}")
  echo "Updated oxfmt: ${current} -> ${latest}"
}

update_oxfmt
