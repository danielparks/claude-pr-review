#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat >&2 <<EOF
Usage: ${0##*/}

Generate .github/workflows/ from examples.
EOF
}

REPO=danielparks/claude-pr-review

if [[ ${1:-} == --help ]]; then
  usage; exit 0
fi

# Generate .github/workflows/ from the updated examples, replacing the
# owner/repo reference with ./ for self-testing.
mkdir -p .github/workflows
for EXAMPLE in workflow-*.yaml; do
  NAME="${EXAMPLE#workflow-}"
  OUT=".github/workflows/claude-$NAME"
  {
    echo "# Generated from $EXAMPLE — do not edit directly."
    echo
    sed "s|uses: ${REPO}@.*|uses: ./|" "$EXAMPLE"
  } > "$OUT"
done
