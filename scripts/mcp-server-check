#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/../mcp-server"

if [[ ! -d node_modules ]] || ! npm ls --depth=0 &>/dev/null; then
  npm ci
fi
npm run check
npm test

# dist/index.js is committed and consumed directly by action.yaml (see
# mcp-server/README.md) -- catch a forgotten rebuild before it ships.
npm run build
git diff --exit-code -- dist
