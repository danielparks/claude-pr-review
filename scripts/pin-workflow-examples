#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

usage() {
  cat >&2 <<EOF
Usage: ${0##*/} [ref] [comment]

Pin the action reference in workflow-*.yaml to the specified git ref.
EOF
}

REF=${1:-HEAD}
COMMENT=${2:-$REF}
REPO=danielparks/claude-pr-review

if [[ $REF == --help ]]; then
  usage; exit 0
fi

SHA=$(git rev-parse "$REF")

echo "Pinning $REPO to $SHA ($REF)  # $COMMENT"

# Update example workflows and README.md to reference the last release. Uses
# temp files for sed portability (macOS vs Linux differ on sed -i).
for EXAMPLE in README.md workflow-*.yaml; do
  TMP=$(mktemp ".$EXAMPLE.temp.XXXXX")
  sed -e "s|uses: ${REPO}@.*|uses: ${REPO}@${SHA}  # ${COMMENT}|" \
    "$EXAMPLE" > "$TMP"
  mv "$TMP" "$EXAMPLE"
  echo "Updated $EXAMPLE"
done
