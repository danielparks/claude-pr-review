#!/usr/bin/env node

// Runs between the diff check and Claude's turn: sets up the environment,
// renders the PR discussion, builds the allowed-tools list, fetches available
// labels, and writes claude_args. Outputs land in $GITHUB_OUTPUT and
// $GITHUB_ENV/$GITHUB_PATH for subsequent steps.

import { randomBytes } from "node:crypto";
import { appendFile, mkdir } from "node:fs/promises";
import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { fetchAndWriteLabels } from "./lib/labels.js";
import { actionContext, fail } from "./lib/util.js";

const execFileAsync = promisify(execFile);

async function run(command, ...args) {
  return await execFileAsync(command, args);
}

function shQuote(value) {
  return "'" + String(value).replace(/'/g, "'\\''") + "'";
}

async function writeOutput(name, value) {
  const delim = `EOF-${randomBytes(8).toString("hex")}`;
  const valueStr = String(value);
  if (valueStr.split("\n").some((line) => line === delim)) {
    fail(
      `Output '${name}' has line matching random delimiter '${delim}'. Retry ` +
        "the workflow.",
    );
  }
  await appendFile(
    process.env.GITHUB_OUTPUT,
    `${name}<<${delim}\n${valueStr}\n${delim}\n`,
  );
}

async function main() {
  const { token, owner, repo, pr } = actionContext();
  const cliDir = process.env.CLI_DIR;
  const renderVersion = process.env.RENDER_VERSION;
  const labelsPatterns = process.env.AVAILABLE_LABELS_PATTERNS || "";
  const allowedTools = process.env.ALLOWED_TOOLS || "";

  // Make CLI_DIR and PR_NUMBER available to subsequent steps.
  await appendFile(
    process.env.GITHUB_ENV,
    `CLI_DIR=${cliDir}\nPR_NUMBER=${pr}\n`,
  );
  await appendFile(process.env.GITHUB_PATH, `${cliDir}\n`);

  // Initialize the review queue and Claude's scratch directory.
  await run("node", `${cliDir}/pr-review`, "init");
  await mkdir("/tmp/pr-review-scratch", { recursive: true });

  // Install gh-pr-render and save its output for Claude's prompt.
  await run("npm", "install", "-g", `gh-pr-render@${renderVersion}`);
  await writeOutput(
    "pr_context",
    (await run("gh-pr-render", `${owner}/${repo}`, pr)).stdout.trimEnd(),
  );

  // Build the comma-separated allowed-tools list, stripping blank lines and
  // comment lines.
  const toolsList = allowedTools
    .split("\n")
    .filter((line) => !/^\s*(#.*)?$/.test(line))
    .join(",");

  // Fetch labels matching the operator's configured patterns and write them so
  // pr-review's label subcommands can enforce the allowlist.
  await fetchAndWriteLabels(token, owner, repo, labelsPatterns);

  if (labelsPatterns.trim()) {
    await writeOutput(
      "label_context",
      (
        await run("node", `${cliDir}/pr-review`, "list-available-labels")
      ).stdout.trimEnd(),
    );
  }

  // Build claude_args for claude-code-action.
  // claude-code-action parses claude_args with shell-quote, so each
  // interpolated value must be POSIX-shell-quoted (single-quoting with
  // each ' replaced by '\'').
  const mcpConfig = JSON.stringify({
    mcpServers: {
      "pr-review-permission-prompt": {
        command: "node",
        args: [`${cliDir}/pr-review-permission-prompt`],
      },
    },
  });

  await writeOutput(
    "value",
    [
      "--allowedTools",
      shQuote(toolsList),
      "--mcp-config",
      shQuote(mcpConfig),
      "--permission-prompt-tool",
      shQuote("mcp__pr-review-permission-prompt__check"),
    ].join(" "),
  );
}

main().catch((error) => {
  // If error resolves to multiple lines only the first line will be considered
  // an error, which is fine.
  console.error(`::error::${error}`);
  process.exit(1);
});
