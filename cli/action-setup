#!/usr/bin/env node

// Runs between the diff check and Claude's turn: sets up the environment,
// renders the PR discussion, builds the allowed-tools list, fetches available
// labels, assembles the prompt within a size limit, and writes claude_args.
//
// Writes to $GITHUB_OUTPUT and $GITHUB_ENV/$GITHUB_PATH for subsequent steps.

import { appendFile, mkdir, writeFile } from "node:fs/promises";
import { execFile } from "node:child_process";
import { promisify } from "node:util";
import { fetchAndWriteLabels } from "./lib/labels.js";
import { assemblePrompt } from "./lib/prompt.js";
import { actionContext, writeOutput } from "./lib/util.js";

const execFileAsync = promisify(execFile);

async function run(command, ...args) {
  return await execFileAsync(command, args);
}

function shQuote(value) {
  return "'" + String(value).replace(/'/g, "'\\''") + "'";
}

async function main() {
  const { token, owner, repo, pr } = actionContext();
  const cliDir = process.env.CLI_DIR;
  const renderVersion = process.env.RENDER_VERSION;
  const labelsPatterns = process.env.AVAILABLE_LABELS_PATTERNS || "";
  const allowedTools = process.env.ALLOWED_TOOLS || "";

  // Make CLI_DIR and PR_NUMBER available to subsequent steps.
  await appendFile(
    process.env.GITHUB_ENV,
    `CLI_DIR=${cliDir}\nPR_NUMBER=${pr}\n`,
  );
  await appendFile(process.env.GITHUB_PATH, `${cliDir}\n`);

  // Initialize the review queue and Claude's scratch directory.
  await run("node", `${cliDir}/pr-review`, "init");
  await mkdir("/tmp/pr-review-scratch", { recursive: true });

  // Install gh-pr-render and save its output for Claude's prompt.
  await run("npm", "install", "-g", `gh-pr-render@${renderVersion}`);
  const discussion = (await run("gh-pr-render", `${owner}/${repo}`, pr)).stdout;

  // Build the comma-separated allowed-tools list, stripping blank lines and
  // comment lines.
  const toolsList = allowedTools
    .split("\n")
    .filter((line) => !/^\s*(#.*)?$/.test(line))
    .join(",");

  // Fetch labels matching the operator's configured patterns and write them so
  // pr-review's label subcommands can enforce the allowlist.
  await fetchAndWriteLabels(token, owner, repo, labelsPatterns);

  const labels = labelsPatterns.trim()
    ? (await run("node", `${cliDir}/pr-review`, "list-available-labels")).stdout
    : "";

  // Assemble the whole prompt here so its total size can be limited; see
  // `MAX_PROMPT_BYTES`. Whatever gets cut is saved in full for Claude to read.
  const paths = {
    discussion: "/tmp/pr-discussion.md",
    diffOfDiffs: "/tmp/pr-diff-of-diffs.md",
  };
  const parts = {
    header: `REPO: ${owner}/${repo}\nPR NUMBER: ${pr}`,
    prompt: process.env.PROMPT || "",
    additionalPrompt: process.env.ADDITIONAL_PROMPT || "",
    labels,
    diffOfDiffs: process.env.DIFF_SECTION || "",
    discussion,
  };
  const { text, shrunk } = assemblePrompt(parts, paths);
  for (const name of shrunk) {
    console.log(`Prompt too long; shortened ${name}, full text in ${paths[name]}`);
    await writeFile(paths[name], parts[name].trimEnd() + "\n");
  }
  await writeOutput("prompt", text);

  // Build claude_args for claude-code-action.
  // claude-code-action parses claude_args with shell-quote, so each
  // interpolated value must be POSIX-shell-quoted (single-quoting with
  // each ' replaced by '\'').
  const mcpConfig = JSON.stringify({
    mcpServers: {
      "pr-review-permission-prompt": {
        command: "node",
        args: [`${cliDir}/pr-review-permission-prompt`],
      },
    },
  });

  // The app token that makes comments post as claude[bot] is revoked when the
  // Claude step finishes, so queued comments have to be swept from inside
  // Claude's process (hooks inherit its environment, like Bash calls do).
  // `action.yaml`'s later sweep step is only a fallback using a weaker token.
  const settings = JSON.stringify({
    hooks: {
      Stop: [
        {
          hooks: [
            {
              type: "command",
              command: `node ${shQuote(`${cliDir}/pr-review`)} sweep --downgrade-approval`,
            },
          ],
        },
      ],
    },
  });

  await writeOutput(
    "value",
    [
      "--settings",
      shQuote(settings),
      "--allowedTools",
      shQuote(toolsList),
      "--mcp-config",
      shQuote(mcpConfig),
      "--permission-prompt-tool",
      shQuote("mcp__pr-review-permission-prompt__check"),
    ].join(" "),
  );
}

main().catch((error) => {
  // If error resolves to multiple lines only the first line will be considered
  // an error, which is fine.
  console.error(`::error::${error}`);
  process.exit(1);
});
