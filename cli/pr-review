#!/usr/bin/env node

// Manipulate PR reviews and comments as claude[bot].
//
// This is a command line tool because the Bash tool provides the Anthropic
// GitHub token that allows posting as claude[bot]. An MCP server spawned by the
// Claude CLI never receives the real GITHUB_TOKEN because the MCP SDK's stdio
// transport spawns servers with a fixed safe env allowlist, not the parent's
// real environment. See ./README.md for more information.

import { readFile } from "node:fs/promises";
import { getOptions, oneOf, positiveInt, required } from "./lib/args.js";
import { fail } from "./lib/util.js";
import {
  claim,
  cleanup,
  initQueue,
  listClaimed,
  markPosted,
  queueComment,
  queueRoot,
  readBatch,
  setReview,
} from "./lib/queue.js";
import {
  apiErrorHint,
  createReply,
  createReview,
  getReview,
  getThreadFirstCommentAuthor,
  getViewerLogin,
  isApprovalRejected,
  minimizeReview,
  resolveReviewThread,
} from "./lib/github.js";
import redact from "./lib/redact.js";

function requireToken() {
  const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;
  if (!token) {
    fail("GITHUB_TOKEN or GH_TOKEN environment variable is required");
  }
  return token;
}

function repoFromEnv() {
  const repo = process.env.GITHUB_REPOSITORY ?? "";
  const match = /^([^/]+)\/([^/]+)$/.exec(repo);
  if (!match) {
    fail(
      "GITHUB_REPOSITORY environment variable must be in owner/repo form, " +
        `got: ${JSON.stringify(repo)}`,
    );
  }
  const [, owner, name] = match;
  return { owner, repo: name };
}

function prNumberFromEnv() {
  return positiveInt(process.env.PR_NUMBER, "PR_NUMBER environment variable");
}

/** Read a comment body file (pass to map for getOptions). */
async function readBodyFile(path, long, info) {
  if (info.required) required(path, long);
  if (!path) return "";

  const body = redact(await readFile(path, "utf8"));
  if (info.required && !body.trim()) {
    fail(`${long} (${path}) is empty`);
  }
  return body;
}

/**
 * Called once by `action.yaml`, before Claude's step starts.
 *
 * See `initQueue`'s doc comment for more information.
 */
async function cmdInit() {
  const root = queueRoot();
  try {
    await initQueue(root);
  } catch (error) {
    if (error.code === "EEXIST") {
      fail(
        `${root} already exists -- refusing to reuse a queue directory ` +
          "this job didn't create fresh. On a self-hosted runner, make " +
          "sure RUNNER_TEMP is cleared between jobs.",
      );
    }
    throw error;
  }
  console.log(`Created queue directory: ${root}`);
}

async function cmdQueueInlineComment(args) {
  const [{ path, line, startLine, side, body }] = await getOptions(args, {
    path: { map: required },
    line: { map: positiveInt },
    startLine: { long: "start-line" },
    side: { map: oneOf("LEFT", "RIGHT"), default: "RIGHT" },
    body: { long: "body-file", map: readBodyFile, required: true },
  });

  const comment = { path, body, side, line };
  if (startLine !== undefined) {
    comment.start_line = positiveInt(startLine, "--start-line");
    if (comment.start_line >= line) {
      fail(`--start-line (${startLine}) must be less than --line (${line})`);
    }
    comment.start_side = side;
  }

  const root = queueRoot();
  const file = await queueComment(root, comment);
  const range =
    comment.start_line !== undefined
      ? `lines ${comment.start_line}-${line}`
      : `line ${line}`;
  console.log(
    `Queued comment for ${path} ${range} (${file}). ` +
      "Call 'comment-review' when you're done adding comments.",
  );
}

async function cmdReplyInlineComment(args) {
  const [{ commentId, body }] = await getOptions(args, {
    commentId: { long: "comment-id", map: positiveInt },
    body: { long: "body-file", map: readBodyFile, required: true },
  });

  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();
  try {
    const result = await createReply(token, owner, repo, pr, commentId, body);
    console.log(`Posted reply: ${result.html_url}`);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

const DOWNGRADE_REJECTED_NOTE =
  "\n\n---\n_This review was submitted as a comment instead of an approval " +
  "because GitHub did not allow this token to approve the pull request._";

const DOWNGRADE_FORCED_NOTE =
  "\n\n---\n_This review was submitted as a comment instead of an approval " +
  "because the review run didn't complete cleanly, or used a lower-" +
  "privilege fallback token, so the approval wasn't trusted as final._";

/**
 * Post one already-claimed batch; mark it posted on success.
 *
 * `forceDowngradeApproval` proactively turns a queued APPROVE into a COMMENT
 * before ever calling the API. Independent of that flag, an APPROVE that GitHub
 * itself rejects because the token isn't permitted to approve is always retried
 * as a COMMENT to avoid losing content.
 */
async function submitClaimedBatch(claimedDir, { forceDowngradeApproval } = {}) {
  const { comments, body, event } = await readBatch(claimedDir);
  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();

  if (event === "COMMENT" && comments.length === 0 && !body) {
    // Nothing worth posting (shouldn't normally happen) -- just tidy up.
    await markPosted(claimedDir);
    return { comments, event, skipped: true };
  }

  let finalEvent = event;
  let finalBody = body;
  if (event === "APPROVE" && forceDowngradeApproval) {
    finalEvent = "COMMENT";
    finalBody = body + DOWNGRADE_FORCED_NOTE;
  }

  let result;
  try {
    result = await createReview(
      token,
      owner,
      repo,
      pr,
      comments,
      finalBody,
      finalEvent,
    );
  } catch (error) {
    if (finalEvent === "APPROVE" && isApprovalRejected(error)) {
      finalEvent = "COMMENT";
      finalBody = body + DOWNGRADE_REJECTED_NOTE;
      result = await createReview(
        token,
        owner,
        repo,
        pr,
        comments,
        finalBody,
        finalEvent,
      );
    } else {
      throw error;
    }
  }
  await markPosted(claimedDir);
  return { comments, event: finalEvent, result };
}

/**
 * Claim batch, record review, and submit to GitHub.
 *
 * If another subagent runs this at the same time, the winner will submit its
 * review with the queued comments, while the loser will only have the review.
 * If the loser has a COMMENT review with no body, then it will return
 * `skipped: true`, otherwise the review will be submitted with no comments.
 */
async function finalizeReview(event, body) {
  const claimedDir = await claim(queueRoot(), { create: true });
  await setReview(claimedDir, event, body);

  try {
    return await submitClaimedBatch(claimedDir);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

async function cmdCommentReview(args) {
  const [{ body }] = await getOptions(args, {
    body: { long: "body-file", map: readBodyFile },
  });
  const { comments, result, skipped } = await finalizeReview("COMMENT", body);
  if (skipped) {
    fail(
      "Nothing to submit: call queue-inline-comment first, or pass " +
        "--body-file for top-level-only feedback.",
    );
  }
  console.log(
    `Submitted review with ${comments.length} inline comment(s): ${result.html_url}`,
  );
}

async function cmdApproveReview(args) {
  const [{ body }] = await getOptions(args, {
    body: { long: "body-file", map: readBodyFile },
  });
  const { comments, event, result } = await finalizeReview("APPROVE", body);
  if (event === "APPROVE") {
    console.log(
      `Submitted APPROVE review with ${comments.length} inline comment(s): ${result.html_url}`,
    );
  } else {
    console.log(
      "GitHub didn't allow approving; submitted as a comment with " +
        `${comments.length} inline comment(s) instead: ${result.html_url}`,
    );
  }
}

async function cmdRequestChangesReview(args) {
  const [{ body }] = await getOptions(args, {
    body: { long: "body-file", map: readBodyFile, required: true },
  });
  const { comments, result } = await finalizeReview("REQUEST_CHANGES", body);
  console.log(
    `Submitted REQUEST_CHANGES review with ${comments.length} inline comment(s): ${result.html_url}`,
  );
}

/**
 * Resolve a thread.
 *
 * `checked` guards against Claude resolving a thread it didn't start.
 */
async function doResolveThread(args, { checked }) {
  const [{ threadId }] = await getOptions(args, {
    threadId: { long: "thread-id", map: required },
  });

  const token = requireToken();

  if (checked) {
    let author, viewerLogin;
    try {
      [author, viewerLogin] = await Promise.all([
        getThreadFirstCommentAuthor(token, threadId),
        getViewerLogin(token),
      ]);
    } catch (error) {
      fail(`${error.message}${apiErrorHint(error)}`);
    }
    if (author !== viewerLogin) {
      fail(
        `Thread ${threadId}'s first comment was authored by ` +
          `${author ?? "unknown"}, not the authenticated user ` +
          `(${viewerLogin}). Use resolve-any-thread instead if you meant to ` +
          "resolve a thread you didn't start.",
      );
    }
  }

  try {
    await resolveReviewThread(token, threadId);
    console.log(`Resolved thread ${threadId}.`);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

function cmdResolveMyThread(args) {
  return doResolveThread(args, { checked: true });
}

function cmdResolveAnyThread(args) {
  return doResolveThread(args, { checked: false });
}

/**
 * Hide a review.
 *
 * `checked` guards against Claude hiding someone else's review.
 */
async function doHideReview(args, { checked }) {
  const [{ reviewId }] = await getOptions(args, {
    reviewId: { long: "review-id", map: positiveInt },
  });

  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();

  let review;
  try {
    review = await getReview(token, owner, repo, pr, reviewId);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }

  if (checked) {
    let viewerLogin;
    try {
      viewerLogin = await getViewerLogin(token);
    } catch (error) {
      fail(`${error.message}${apiErrorHint(error)}`);
    }
    if (review.user?.login !== viewerLogin) {
      fail(
        `Review ${reviewId} was authored by ` +
          `${review.user?.login ?? "unknown"}, not the authenticated user ` +
          `(${viewerLogin}). Use hide-any-review instead if you meant to ` +
          "hide someone else's review.",
      );
    }
  }

  try {
    await minimizeReview(token, review.node_id);
    console.log(`Hid review ${reviewId} as outdated.`);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

function cmdHideMyReview(args) {
  return doHideReview(args, { checked: true });
}

function cmdHideAnyReview(args) {
  return doHideReview(args, { checked: false });
}

/**
 * Invoked by the deferred fallback step after Claude's run ends, not by
 * Claude itself. Idempotent no matter how many times it runs or what state
 * it finds: posts anything Claude queued but never submitted, retries any
 * abandoned in-flight attempt from a crashed comment-review, and leaves
 * already-posted batches alone.
 *
 * `--downgrade-approval` proactively turns any queued APPROVE into a
 * COMMENT -- `action.yaml` passes this when the Claude step didn't
 * succeed, or when it's using the plain `github.token` fallback instead of
 * the Claude App token, since neither circumstance should get to submit an
 * approval sweep never actually watched happen live.
 */
async function cmdSweep(args) {
  const [{ forceDowngradeApproval }] = await getOptions(args, {
    forceDowngradeApproval: { type: "boolean", long: "downgrade-approval" },
  });

  const root = queueRoot();
  let handled = 0;
  let failed = 0;

  const liveClaim = await claim(root);
  if (liveClaim) {
    console.log(`Found un-submitted comments queued at ${liveClaim}.`);
    if (await trySubmit(liveClaim, { forceDowngradeApproval })) handled++;
    else failed++;
  }

  for (const dir of await listClaimed(root)) {
    console.error(
      `::warning::Retrying abandoned review submission from ${dir}`,
    );
    if (await trySubmit(dir, { forceDowngradeApproval })) handled++;
    else failed++;
  }

  if (handled === 0 && failed === 0) {
    console.log("Nothing to sweep.");
  } else {
    console.log(
      `Swept ${handled} pending submission(s), ${failed} failure(s).`,
    );
  }

  if (failed > 0) {
    process.exitCode = 1;
  } else {
    // Only delete queue on success.
    await cleanup(root);
  }
}

async function trySubmit(claimedDir, submitOpts) {
  try {
    await submitClaimedBatch(claimedDir, submitOpts);
    return true;
  } catch (error) {
    console.error(
      `::error::Failed to submit queued review from ${claimedDir}: ` +
        `${error.message}${apiErrorHint(error)}`,
    );
    return false;
  }
}

const COMMANDS = {
  init: cmdInit,
  "queue-inline-comment": cmdQueueInlineComment,
  "reply-inline-comment": cmdReplyInlineComment,
  "comment-review": cmdCommentReview,
  "approve-review": cmdApproveReview,
  "request-changes-review": cmdRequestChangesReview,
  "resolve-my-thread": cmdResolveMyThread,
  "resolve-any-thread": cmdResolveAnyThread,
  "hide-my-review": cmdHideMyReview,
  "hide-any-review": cmdHideAnyReview,
  sweep: cmdSweep,
};

async function main() {
  const [, , command, ...rest] = process.argv;
  const handler = COMMANDS[command];
  if (!handler) {
    fail(
      `Unknown command: ${command ?? "(none)"}. Expected one of: ` +
        Object.keys(COMMANDS).join(", "),
    );
  }
  await handler(rest);
}

main().catch((error) => {
  const message = error instanceof Error ? error.message : String(error);
  console.error(`Error: ${message}`);
  process.exit(1);
});
