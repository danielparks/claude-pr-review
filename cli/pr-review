#!/usr/bin/env node

// Post PR review comments as claude[bot].
//
// This is a command line tool because the Bash tool provides the Anthropic
// GitHub token that allows posting as claude[bot]. An MCP server spawned by the
// Claude CLI never receives the real GITHUB_TOKEN because the MCP SDK's stdio
// transport spawns servers with a fixed safe env allowlist, not the parent's
// real environment. See ./README.md for more information.

import { parseArgs } from "node:util";
import { readFile } from "node:fs/promises";
import {
  claim,
  cleanup,
  initQueue,
  listClaimed,
  markPosted,
  queueComment,
  queueRoot,
  readBatch,
  setBody,
  setEvent,
} from "./lib/queue.js";
import {
  apiErrorHint,
  createReply,
  createReview,
  hideReview,
  isApprovalRejected,
  resolveReviewThread,
} from "./lib/github.js";
import { redactGitHubTokens } from "./lib/redact.js";

class CliError extends Error {}

function fail(message) {
  throw new CliError(message);
}

function requireToken() {
  const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;
  if (!token) {
    fail("GITHUB_TOKEN or GH_TOKEN environment variable is required");
  }
  return token;
}

function repoFromEnv() {
  const repo = process.env.GITHUB_REPOSITORY ?? "";
  const match = /^([^/]+)\/([^/]+)$/.exec(repo);
  if (!match) {
    fail(
      "GITHUB_REPOSITORY environment variable must be in owner/repo form, " +
        `got: ${JSON.stringify(repo)}`,
    );
  }
  const [, owner, name] = match;
  return { owner, repo: name };
}

function prNumberFromEnv() {
  return positiveInt(process.env.PR_NUMBER, "PR_NUMBER environment variable");
}

function positiveInt(value, label) {
  const n = Number(value);
  if (!Number.isInteger(n) || n < 1) {
    fail(`${label} must be a positive integer, got: ${value}`);
  }
  return n;
}

async function readBodyFile(filePath, { required }) {
  if (!filePath) {
    if (required) fail("--body-file is required");
    return "";
  }
  const raw = await readFile(filePath, "utf8");
  const body = redactGitHubTokens(raw);
  if (required && !body.trim()) {
    fail(`--body-file (${filePath}) is empty`);
  }
  return body;
}

/**
 * Called once by `action.yaml`, before Claude's turn starts -- never by
 * Claude itself. See `initQueue`'s doc comment for why this needs to be
 * exclusive rather than just ensuring the directory exists.
 */
async function cmdInit() {
  const root = queueRoot();
  try {
    await initQueue(root);
  } catch (error) {
    if (error.code === "EEXIST") {
      fail(
        `${root} already exists -- refusing to reuse a queue directory ` +
          "this job didn't create fresh. On a self-hosted runner, make " +
          "sure RUNNER_TEMP is cleared between jobs.",
      );
    }
    throw error;
  }
  console.log(`Created queue directory: ${root}`);
}

async function cmdQueueInlineComment(args) {
  const { values } = parseArgs({
    args,
    options: {
      path: { type: "string" },
      line: { type: "string" },
      "start-line": { type: "string" },
      side: { type: "string" },
      "body-file": { type: "string" },
    },
  });
  if (!values.path) fail("--path is required");
  if (!values.line) fail("--line is required");

  const line = positiveInt(values.line, "--line");
  const side = values.side ?? "RIGHT";
  if (side !== "LEFT" && side !== "RIGHT") {
    fail(`--side must be LEFT or RIGHT, got: ${values.side}`);
  }
  const body = await readBodyFile(values["body-file"], { required: true });

  const comment = { path: values.path, body, side, line };
  if (values["start-line"] !== undefined) {
    const startLine = positiveInt(values["start-line"], "--start-line");
    if (startLine >= line) {
      fail(`--start-line (${startLine}) must be less than --line (${line})`);
    }
    comment.start_line = startLine;
    comment.start_side = side;
  }

  const root = queueRoot();
  const file = await queueComment(root, comment);
  const range =
    comment.start_line !== undefined
      ? `lines ${comment.start_line}-${line}`
      : `line ${line}`;
  console.log(
    `Queued comment for ${values.path} ${range} (${file}). ` +
      "Call 'comment-review' when you're done adding comments.",
  );
}

async function cmdReplyInlineComment(args) {
  const { values } = parseArgs({
    args,
    options: {
      "comment-id": { type: "string" },
      "body-file": { type: "string" },
    },
  });
  if (!values["comment-id"]) fail("--comment-id is required");
  const commentId = positiveInt(values["comment-id"], "--comment-id");
  const body = await readBodyFile(values["body-file"], { required: true });

  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();
  try {
    const result = await createReply(token, owner, repo, pr, commentId, body);
    console.log(`Posted reply: ${result.html_url}`);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

const DOWNGRADE_REJECTED_NOTE =
  "\n\n---\n_This review was submitted as a comment instead of an approval " +
  "because GitHub did not allow this token to approve the pull request._";

const DOWNGRADE_FORCED_NOTE =
  "\n\n---\n_This review was submitted as a comment instead of an approval " +
  "because the review run didn't complete cleanly, or used a lower-" +
  "privilege fallback token, so the approval wasn't trusted as final._";

/**
 * Post one already-claimed batch; mark it posted on success.
 *
 * `forceDowngradeApproval` proactively turns a queued APPROVE into a
 * COMMENT before ever calling the API -- used by `sweep --downgrade-approval`
 * when the circumstances (a failed run, or a lower-privilege fallback token)
 * mean an approval shouldn't be trusted as final. Independent of that flag,
 * an APPROVE that GitHub itself rejects because the token isn't permitted to
 * approve is always retried as a COMMENT -- there's never a good reason to
 * let that specific, known rejection surface as a hard failure instead.
 */
async function submitClaimedBatch(claimedDir, { forceDowngradeApproval } = {}) {
  const { comments, body, event } = await readBatch(claimedDir);
  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();

  if (event === "COMMENT" && comments.length === 0 && !body) {
    // Nothing worth posting (shouldn't normally happen) -- just tidy up.
    await markPosted(claimedDir);
    return { comments, event, skipped: true };
  }

  let finalEvent = event;
  let finalBody = body;
  if (event === "APPROVE" && forceDowngradeApproval) {
    finalEvent = "COMMENT";
    finalBody = body + DOWNGRADE_FORCED_NOTE;
  }

  let result;
  try {
    result = await createReview(
      token,
      owner,
      repo,
      pr,
      comments,
      finalBody,
      finalEvent,
    );
  } catch (error) {
    if (finalEvent === "APPROVE" && isApprovalRejected(error)) {
      finalEvent = "COMMENT";
      finalBody = body + DOWNGRADE_REJECTED_NOTE;
      result = await createReview(
        token,
        owner,
        repo,
        pr,
        comments,
        finalBody,
        finalEvent,
      );
    } else {
      throw error;
    }
  }
  await markPosted(claimedDir);
  return { comments, event: finalEvent, result };
}

/**
 * Shared by `comment-review`, `approve-review`, and `request-changes-review`:
 * record the decided event (and optional body) in the queue, claim it, and
 * submit it. Writing `--body-file` is conditional (no point creating an
 * empty `_body.txt`), but `setEvent` always runs, even with nothing else
 * queued -- that's what makes a bare `approve-review` with no comments and
 * no body work: it still creates the batch directory, so `claim` never
 * returns null.
 */
async function finalizeReview(args, event, { requireBody }) {
  const { values } = parseArgs({
    args,
    options: { "body-file": { type: "string" } },
  });
  const root = queueRoot();
  if (values["body-file"] || requireBody) {
    const body = await readBodyFile(values["body-file"], {
      required: requireBody,
    });
    await setBody(root, body);
  }
  await setEvent(root, event);

  const claimedDir = await claim(root);
  try {
    return await submitClaimedBatch(claimedDir);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

async function cmdCommentReview(args) {
  const { comments, result, skipped } = await finalizeReview(args, "COMMENT", {
    requireBody: false,
  });
  if (skipped) {
    fail(
      "Nothing to submit: call queue-inline-comment first, or pass " +
        "--body-file for top-level-only feedback.",
    );
  }
  console.log(
    `Submitted review with ${comments.length} inline comment(s): ${result.html_url}`,
  );
}

async function cmdApproveReview(args) {
  const { comments, event, result } = await finalizeReview(args, "APPROVE", {
    requireBody: false,
  });
  if (event === "APPROVE") {
    console.log(
      `Submitted APPROVE review with ${comments.length} inline comment(s): ${result.html_url}`,
    );
  } else {
    console.log(
      "GitHub didn't allow approving; submitted as a comment with " +
        `${comments.length} inline comment(s) instead: ${result.html_url}`,
    );
  }
}

async function cmdRequestChangesReview(args) {
  const { comments, result } = await finalizeReview(args, "REQUEST_CHANGES", {
    requireBody: true,
  });
  console.log(
    `Submitted REQUEST_CHANGES review with ${comments.length} inline comment(s): ${result.html_url}`,
  );
}

async function cmdResolveThread(args) {
  const { values } = parseArgs({
    args,
    options: { "thread-id": { type: "string" } },
  });
  if (!values["thread-id"]) fail("--thread-id is required");

  const token = requireToken();
  try {
    await resolveReviewThread(token, values["thread-id"]);
    console.log(`Resolved thread ${values["thread-id"]}.`);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

async function cmdHideReview(args) {
  const { values } = parseArgs({
    args,
    options: { "review-id": { type: "string" } },
  });
  if (!values["review-id"]) fail("--review-id is required");
  const reviewId = positiveInt(values["review-id"], "--review-id");

  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();
  try {
    await hideReview(token, owner, repo, pr, reviewId);
    console.log(`Hid review ${reviewId} as outdated.`);
  } catch (error) {
    fail(`${error.message}${apiErrorHint(error)}`);
  }
}

/**
 * Invoked by the deferred fallback step after Claude's run ends, not by
 * Claude itself. Idempotent no matter how many times it runs or what state
 * it finds: posts anything Claude queued but never submitted, retries any
 * abandoned in-flight attempt from a crashed comment-review, and leaves
 * already-posted batches alone.
 *
 * `--downgrade-approval` proactively turns any queued APPROVE into a
 * COMMENT -- `action.yaml` passes this when the Claude step didn't
 * succeed, or when it's using the plain `github.token` fallback instead of
 * the Claude App token, since neither circumstance should get to submit an
 * approval sweep never actually watched happen live.
 */
async function cmdSweep(args) {
  const { values } = parseArgs({
    args,
    options: { "downgrade-approval": { type: "boolean" } },
  });
  const submitOpts = { forceDowngradeApproval: values["downgrade-approval"] };

  const root = queueRoot();
  let handled = 0;
  let failed = 0;

  const liveClaim = await claim(root);
  if (liveClaim) {
    console.log(`Found un-submitted comments queued at ${liveClaim}.`);
    if (await trySubmit(liveClaim, submitOpts)) handled++;
    else failed++;
  }

  for (const dir of await listClaimed(root)) {
    console.error(
      `::warning::Retrying abandoned review submission from ${dir}`,
    );
    if (await trySubmit(dir, submitOpts)) handled++;
    else failed++;
  }

  if (handled === 0 && failed === 0) {
    console.log("Nothing to sweep.");
  } else {
    console.log(
      `Swept ${handled} pending submission(s), ${failed} failure(s).`,
    );
  }

  if (failed > 0) {
    process.exitCode = 1;
  } else {
    // Only delete queue on success.
    await cleanup(root);
  }
}

async function trySubmit(claimedDir, submitOpts) {
  try {
    await submitClaimedBatch(claimedDir, submitOpts);
    return true;
  } catch (error) {
    console.error(
      `::error::Failed to submit queued review from ${claimedDir}: ` +
        `${error.message}${apiErrorHint(error)}`,
    );
    return false;
  }
}

const COMMANDS = {
  init: cmdInit,
  "queue-inline-comment": cmdQueueInlineComment,
  "reply-inline-comment": cmdReplyInlineComment,
  "comment-review": cmdCommentReview,
  "approve-review": cmdApproveReview,
  "request-changes-review": cmdRequestChangesReview,
  "resolve-thread": cmdResolveThread,
  "hide-review": cmdHideReview,
  sweep: cmdSweep,
};

async function main() {
  const [, , command, ...rest] = process.argv;
  const handler = COMMANDS[command];
  if (!handler) {
    fail(
      `Unknown command: ${command ?? "(none)"}. Expected one of: ` +
        Object.keys(COMMANDS).join(", "),
    );
  }
  await handler(rest);
}

main().catch((error) => {
  const message = error instanceof Error ? error.message : String(error);
  console.error(`Error: ${message}`);
  process.exit(1);
});
