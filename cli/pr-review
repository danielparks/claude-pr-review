#!/usr/bin/env node

// Manipulate PR reviews and comments as claude[bot].
//
// This is a command line tool because the Bash tool provides the Anthropic
// GitHub token that allows posting as claude[bot]. An MCP server spawned by the
// Claude CLI never receives the real GITHUB_TOKEN because the MCP SDK's stdio
// transport spawns servers with a fixed safe env allowlist, not the parent's
// real environment. See ./README.md for more information.

import { readFile } from "node:fs/promises";
import path from "node:path";
import {
  Commands,
  HelpRequested,
  oneOf,
  positiveInt,
  required,
} from "./lib/args.js";
import { CliError, countLines, fail } from "./lib/util.js";
import {
  claim,
  cleanup,
  discardClaimed,
  initQueue,
  listClaimed,
  listQueue,
  markPosted,
  queueComment,
  queueRoot,
  readBatch,
  setReview,
} from "./lib/queue.js";
import {
  apiErrorHint,
  createIssueComment,
  createReply,
  createReview,
  getReview,
  getThreadFirstCommentAuthor,
  getViewerLogin,
  isApprovalRejected,
  listIssueComments,
  minimizeReview,
  resolveReviewThread,
  updateIssueComment,
  withApiError,
} from "./lib/github.js";
import redact from "./lib/redact.js";

const COMMANDS = new Commands();

function requireToken() {
  const token = process.env.GITHUB_TOKEN || process.env.GH_TOKEN;
  if (!token) {
    fail("GITHUB_TOKEN or GH_TOKEN environment variable is required");
  }
  return token;
}

function repoFromEnv() {
  const repo = process.env.GITHUB_REPOSITORY ?? "";
  const match = /^([^/]+)\/([^/]+)$/.exec(repo);
  if (!match) {
    fail(
      "GITHUB_REPOSITORY environment variable must be in owner/repo form, " +
        `got: ${JSON.stringify(repo)}`,
    );
  }
  const [, owner, name] = match;
  return { owner, repo: name };
}

function prNumberFromEnv() {
  return positiveInt(process.env.PR_NUMBER, "PR_NUMBER environment variable");
}

/** Read a comment body file (pass to map for getOptions). */
async function readBodyFile(path, long, info) {
  if (info.required) required(path, long);
  if (!path) return "";

  const body = redact(await readFile(path, "utf8"));
  if (info.required && !body.trim()) {
    fail(`${long} (${path}) is empty`);
  }
  return body;
}

/**
 * Called once by `action.yaml`, before Claude's step starts.
 *
 * See `initQueue`'s doc comment for more information.
 */
COMMANDS.add(
  "init",
  "Create the queue directory. Run once by action.yaml before Claude's turn " +
    "starts. Claude shouldn't call this and it is not enabled as an " +
    "allowed-tool by default.",
  {},
  async () => {
    const root = queueRoot();
    try {
      await initQueue(root);
    } catch (error) {
      if (error.code === "EEXIST") {
        fail(
          `${root} already exists -- refusing to reuse a queue directory ` +
            "this job didn't create fresh. On a self-hosted runner, make " +
            "sure RUNNER_TEMP is cleared between jobs.",
        );
      }
      throw error;
    }
    console.log(`Created queue directory: ${root}`);
  },
);

COMMANDS.add(
  "queue-inline-comment",
  "Queue an inline comment. Nothing is posted until a review is finalized.",
  {
    path: {
      map: required,
      description:
        "File path, relative to the repo root, as it appears in the diff.",
    },
    line: {
      map: positiveInt,
      description:
        "Line number in the file's new version (or old version, if " +
        "--side LEFT) to attach the comment to. Must be part of the diff.",
    },
    startLine: {
      long: "start-line",
      description:
        "Start of a multi-line comment range; the comment covers " +
        "--start-line through --line. Omit for a single-line comment.",
    },
    side: {
      map: oneOf("LEFT", "RIGHT"),
      default: "RIGHT",
      description:
        "Which version of the diff --line/--start-line refer to: RIGHT is " +
        "the new version, LEFT is the old.",
    },
    body: {
      long: "body-file",
      map: readBodyFile,
      required: true,
      description: "Path to a file containing the comment body.",
    },
  },
  async ({ path, line, startLine, side, body }) => {
    const comment = { path, body, side, line };
    if (startLine !== undefined) {
      comment.start_line = positiveInt(startLine, "--start-line");
      if (comment.start_line >= line) {
        fail(`--start-line (${startLine}) must be less than --line (${line})`);
      }
      comment.start_side = side;
    }

    const root = queueRoot();
    const file = await queueComment(root, comment);
    const range =
      comment.start_line !== undefined
        ? `lines ${comment.start_line}-${line}`
        : `line ${line}`;
    console.log(
      `Queued comment for ${path} ${range} (${file}). ` +
        "Call 'comment-review' when you're done adding comments.",
    );
  },
);

COMMANDS.add(
  "reply-inline-comment",
  "Reply to an existing inline comment thread. Posts immediately.",
  {
    commentId: {
      long: "comment-id",
      map: positiveInt,
      description: "ID of the existing inline review comment to reply to.",
    },
    body: {
      long: "body-file",
      map: readBodyFile,
      required: true,
      description: "Path to a file containing the reply body.",
    },
  },
  async ({ commentId, body }) => {
    const token = requireToken();
    const { owner, repo } = repoFromEnv();
    const pr = prNumberFromEnv();
    const result = await withApiError(() =>
      createReply(token, owner, repo, pr, commentId, body),
    );
    console.log(`Posted reply: ${result.html_url}`);
  },
);

const STICKY_MARKER = "<!-- pr-review: sticky comment -->\n\n";

/**
 * Create or update a single sticky top-level comment.
 *
 * This only ever writes a single comment authored by the authenticated user and
 * containing a special marker. It can’t be used to edit any other comment.
 */
COMMANDS.add(
  "update-sticky-comment",
  "Create or update a single sticky top-level comment. This is not enabled " +
    "as an allowed-tool by default.",
  {
    body: { long: "body-file", map: readBodyFile, required: true },
  },
  async ({ body }) => {
    const token = requireToken();
    const { owner, repo } = repoFromEnv();
    const pr = prNumberFromEnv();
    const fullBody = `${STICKY_MARKER}${body}`;

    const [viewerLogin, comments] = await withApiError(() =>
      Promise.all([
        getViewerLogin(token),
        listIssueComments(token, owner, repo, pr),
      ]),
    );
    const existing = comments.find(
      (comment) =>
        comment.user?.login === viewerLogin &&
        comment.body?.includes(STICKY_MARKER),
    );

    if (existing) {
      const result = await withApiError(() =>
        updateIssueComment(token, owner, repo, existing.id, fullBody),
      );
      console.log(`Updated sticky comment: ${result.html_url}`);
    } else {
      const result = await withApiError(() =>
        createIssueComment(token, owner, repo, pr, fullBody),
      );
      console.log(`Created sticky comment: ${result.html_url}`);
    }
  },
);

const DOWNGRADE_REJECTED_NOTE =
  "\n\n---\n_This review was submitted as a comment instead of an approval " +
  "because GitHub did not allow this token to approve the pull request._";

const DOWNGRADE_FORCED_NOTE =
  "\n\n---\n_This review was submitted as a comment instead of an approval " +
  "because the review run didn't complete cleanly, or used a lower-" +
  "privilege fallback token, so the approval wasn't trusted as final._";

/**
 * Post one already-claimed batch.
 *
 * This does *not* mark the batch as posted in order to avoid conflating errors
 * thrown while submitting with errors thrown while marking the batch. You must
 * call `markPosted` after this if it succeeds.
 *
 * `forceDowngradeApproval` proactively turns a queued APPROVE into a COMMENT
 * before ever calling the API. Independent of that flag, an APPROVE that GitHub
 * itself rejects because the token isn't permitted to approve is always retried
 * as a COMMENT to avoid losing content.
 *
 * This will do nothing and return `skipped: true` for REQUEST_CHANGES and
 * COMMENT reviews if there are no queued inline comments and no review body.
 */
async function submitClaimedBatch(claimedDir, { forceDowngradeApproval } = {}) {
  const { comments, body, event } = await readBatch(claimedDir);
  const token = requireToken();
  const { owner, repo } = repoFromEnv();
  const pr = prNumberFromEnv();

  if (
    (event === "COMMENT" || event === "REQUEST_CHANGES") &&
    comments.length === 0 &&
    !body
  ) {
    // Nothing worth posting (shouldn't normally happen).
    return { comments, event, skipped: true };
  }

  let finalEvent = event;
  let finalBody = body;
  if (event === "APPROVE" && forceDowngradeApproval) {
    finalEvent = "COMMENT";
    finalBody = body + DOWNGRADE_FORCED_NOTE;
  }

  let result;
  try {
    result = await createReview(
      token,
      owner,
      repo,
      pr,
      comments,
      finalBody,
      finalEvent,
    );
  } catch (error) {
    if (finalEvent === "APPROVE" && isApprovalRejected(error)) {
      finalEvent = "COMMENT";
      finalBody = body + DOWNGRADE_REJECTED_NOTE;
      result = await createReview(
        token,
        owner,
        repo,
        pr,
        comments,
        finalBody,
        finalEvent,
      );
    } else {
      throw error;
    }
  }
  return { comments, event: finalEvent, result };
}

/**
 * Claim batch, record review, and submit to GitHub.
 *
 * If another subagent runs this at the same time, the winner will submit its
 * review with the queued comments, while the loser will only have the review.
 *
 * This will fail for COMMENT and REQUEST_CHANGES reviews if there are no queued
 * inline comments and the review body is empty.
 */
async function finalizeReview(event, body) {
  const claimedDir = await claim(queueRoot(), { create: true });
  await setReview(claimedDir, event, body);

  let result;
  try {
    result = await submitClaimedBatch(claimedDir);
  } catch (error) {
    fail(
      `${error.message}${apiErrorHint(error)}\n` +
        "\n" +
        `This batch is still queued at ${claimedDir}, and will be retried ` +
        "automatically after your turn ends -- which may fail again the " +
        "same way and fail the job. Fix the problem and try again; once a " +
        "corrected version has been submitted successfully, remove this " +
        `one with: pr-review discard-queue --dir ${claimedDir}`,
    );
  }

  try {
    await markPosted(claimedDir);
  } catch (error) {
    fail(
      `Could not mark ${claimedDir} as posted: ${error}\n` +
        "\n" +
        "You can attempt to delete it with:\n" +
        "\n" +
        `    pr-review discard-queue --dir ${claimedDir}`,
    );
  }

  if (result.skipped) {
    fail(
      "Nothing to submit: call queue-inline-comment first, or pass " +
        "--body-file for top-level-only feedback.",
    );
  }

  return result;
}

