/**
 * Invoked by the deferred fallback step after Claude's run ends, not by
 * Claude itself. Idempotent no matter how many times it runs or what state
 * it finds: posts anything Claude queued but never submitted, retries any
 * abandoned in-flight attempt from a crashed comment-review, and leaves
 * already-posted batches alone.
 *
 * `--downgrade-approval` proactively turns any queued APPROVE into a
 * COMMENT -- `action.yaml` passes this when the Claude step didn't
 * succeed, or when it's using the plain `github.token` fallback instead of
 * the Claude App token, since neither circumstance should get to submit an
 * approval sweep never actually watched happen live.
 */
COMMANDS.add(
  "sweep",
  "Post anything still queued after Claude's turn ends. Run automatically by " +
    "action.yaml; Claude shouldn't call this and it is not enabled as an " +
    "allowed-tool by default.",
  {
    forceDowngradeApproval: {
      type: "boolean",
      long: "downgrade-approval",
      description:
        "Force any queued APPROVE to submit as COMMENT instead (with an " +
        "explanatory note appended).",
    },
  },
  async ({ forceDowngradeApproval }) => {
    const root = queueRoot();
    let handled = 0;
    let failed = 0;

    const liveClaim = await claim(root);
    if (liveClaim) {
      console.log(`Found un-submitted comments queued at ${liveClaim}.`);
      if (await trySubmit(liveClaim, { forceDowngradeApproval })) handled++;
      else failed++;
    }

    for (const dir of await listClaimed(root)) {
      console.error(
        `::warning::Retrying abandoned review submission from ${dir}`,
      );
      if (await trySubmit(dir, { forceDowngradeApproval })) handled++;
      else failed++;
    }

    if (handled === 0 && failed === 0) {
      console.log("Nothing to sweep.");
    } else {
      console.log(
        `Swept ${handled} pending submission(s), ${failed} failure(s).`,
      );
    }

    if (failed > 0) {
      process.exitCode = 1;
    } else {
      // Only delete queue on success.
      await cleanup(root);
    }
  },
);

async function trySubmit(claimedDir, submitOpts) {
  try {
    await submitClaimedBatch(claimedDir, submitOpts);
  } catch (error) {
    console.error(
      `::error::Failed to submit queued review from ${claimedDir}: ` +
        `${error.message}${apiErrorHint(error)}`,
    );
    return false;
  }

  try {
    await markPosted(claimedDir);
  } catch (error) {
    console.error(
      `::warning::Successfully submitted ${claimedDir}, but could not mark ` +
        `it posted: ${error}`,
    );
    return false;
  }

  return true;
}

/** Convert a glob pattern (supporting only '*') to a RegExp anchored at start. */
function globToRegex(pattern) {
  return new RegExp(
    "^" + pattern.replace(/[.+^${}()|[\]\\]/g, "\\$&").replace(/\*/g, ".*"),
  );
}

/**
 * Check whether calling `pr-review <name>` would be allowed by the raw
 * allowed-tools list (newline-separated, comment lines allowed).
 *
 * Handles:
 *   Bash             → all bash allowed
 *   Bash(prefix:*)   → bash commands whose line starts with `prefix` (glob ok)
 *   Bash(prefix)     → same without the ':*' trailer
 *
 * Limitation: argument-constrained patterns like
 * `Bash(pr-review update-sticky-comment --body-file *)` won't be recognized
 * as enabling `update-sticky-comment` — the check only looks at the command
 * prefix (before ':'). See the `allowed-tools` input description.
 */
function isSubcommandEnabled(name, rawAllowedTools) {
  const entries = rawAllowedTools
    .split("\n")
    .map((line) => line.replace(/#.*$/, "").trim())
    .filter(Boolean);

  const cmdToCheck = `pr-review ${name}`;

  for (const entry of entries) {
    if (entry === "Bash") return true;

    const match = /^Bash\((.+)\)$/.exec(entry);
    if (!match) continue;

    const pattern = match[1];
    const colonIdx = pattern.indexOf(":");
    const cmdPrefix = colonIdx >= 0 ? pattern.slice(0, colonIdx) : pattern;
    if (globToRegex(cmdPrefix).test(cmdToCheck)) return true;
  }

  return false;
}

function formatTopLevelHelp() {
  const allNames = COMMANDS.names();

  let enabledNames, disabledNames;
  const rawAllowedTools = process.env.PR_REVIEW_ALLOWED_TOOLS;
  if (rawAllowedTools) {
    const hasEntries = rawAllowedTools
      .split("\n")
      .some((line) => line.replace(/#.*$/, "").trim());
    if (hasEntries) {
      enabledNames = allNames.filter((n) =>
        isSubcommandEnabled(n, rawAllowedTools),
      );
      disabledNames = allNames.filter(
        (n) => !isSubcommandEnabled(n, rawAllowedTools),
      );
    }
  }
  enabledNames ??= allNames;
  disabledNames ??= [];

  const lines = ["Usage: pr-review <command> [options]", "", "Commands:"];

  if (enabledNames.length > 0) {
    const width = Math.max(...enabledNames.map((name) => name.length));
    lines.push(
      ...enabledNames.map(
        (name) => `  ${name.padEnd(width)}  ${COMMANDS.get(name).description}`,
      ),
    );
  }

  if (disabledNames.length > 0) {
    lines.push("", `Not enabled for this run: ${disabledNames.join(", ")}`);
  }

  lines.push(
    "",
    "Run 'pr-review <command> --help' for details on a specific command.",
  );

  return lines.join("\n");
}

async function main() {
  const [, , command, ...rest] = process.argv;
  if (command === undefined || command === "--help" || command === "-h") {
    console.log(formatTopLevelHelp());
    return;
  }

  const entry = COMMANDS.get(command);
  if (!entry) {
    fail(
      `Unknown command: ${command}. Expected one of: ` +
        COMMANDS.names().join(", "),
    );
  }
  await entry(rest);
}

main().catch((error) => {
  if (error instanceof HelpRequested) {
    console.log(error.message);
    return;
  }
  if (error instanceof CliError) {
    console.error(`Error: ${error.message}`);
  } else {
    console.error(error);
  }
  process.exit(1);
});
