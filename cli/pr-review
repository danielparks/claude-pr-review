function formatQueuedComment(comment) {
  const range =
    comment.start_line !== undefined
      ? `${comment.start_line}-${comment.line}`
      : `${comment.line}`;
  const firstLine = comment.body.split("\n")[0];
  return `  ${comment.path}:${range}: ${firstLine}`;
}

/**
 * Show every batch currently in the queue, in any state, so Claude can spot
 * (and then remove with `discard-queue`) a claimed batch that's stuck
 * retrying a submission that will never succeed -- e.g. one GitHub rejected
 * for an invalid inline comment line number, after a corrected batch has
 * already been submitted successfully in its place.
 */
COMMANDS.add(
  "list-queue",
  "Show every batch currently in the queue, in any state.",
  {},
  async () => {
    const root = queueRoot();
    const batches = await listQueue(root);
    if (batches.length === 0) {
      console.log(`Nothing queued (${root}).`);
      return;
    }

    for (const { dir, state, comments, body, event } of batches) {
      console.log(
        `${dir} [${state}] ${event}: ${comments.length} inline comment(s)` +
          (body
            ? `, ${countLines(body)} line top-level body`
            : ", no top-level body"),
      );
      for (const comment of comments) {
        console.log(formatQueuedComment(comment));
      }
    }
  },
);

/**
 * Permanently remove a claimed batch without submitting it. Meant for a
 * batch `list-queue` shows stuck after a submission failed for a reason
 * that won't change on retry (e.g. an invalid line number) -- once the
 * corrected content has been submitted successfully some other way, this
 * stops `sweep` from retrying the original and failing the job.
 *
 * Only accepts a directory directly inside the queue root, as printed by
 * `list-queue`, so a crafted path can't be used to delete something else.
 */
COMMANDS.add(
  "discard-queue",
  "Permanently remove a stuck claimed batch without submitting it.",
  {
    dir: {
      map: required,
      description:
        "Path to the claimed batch directory to discard, exactly as printed " +
        "by list-queue.",
    },
  },
  async ({ dir }) => {
    const root = queueRoot();
    const resolved = path.resolve(dir);
    if (path.dirname(resolved) !== path.resolve(root)) {
      fail(
        `--dir must be a batch directory directly inside the queue root ` +
          `(${root}), as printed by 'list-queue'. Got: ${dir}`,
      );
    }

    await discardClaimed(resolved);
    console.log(`Discarded ${resolved}.`);
  },
);

/**
 * Resolve a thread.
 *
 * `checked` guards against Claude resolving a thread it didn't start.
 */
async function doResolveThread({ checked, threadId }) {
  const token = requireToken();

  if (checked) {
    const [author, viewerLogin] = await withApiError(() =>
      Promise.all([
        getThreadFirstCommentAuthor(token, threadId),
        getViewerLogin(token),
      ]),
    );
    if (author !== viewerLogin) {
      fail(
        `Thread ${threadId}'s first comment was authored by ` +
          `${author ?? "unknown"}, not the authenticated user ` +
          `(${viewerLogin}). Use resolve-any-thread instead if you meant to ` +
          "resolve a thread you didn't start.",
      );
    }
  }

  await withApiError(() => resolveReviewThread(token, threadId));
  console.log(`Resolved thread ${threadId}.`);
}

const RESOLVE_THREAD_OPTIONS = {
  threadId: {
    long: "thread-id",
